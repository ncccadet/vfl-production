# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL on RDS) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/voxera_law

# ── Redis (ElastiCache) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_long_random_string_access
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_FILES=voxera-law-files
S3_BUCKET_FRONTEND=voxera-law-frontend

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Hard cap on LLM-extract calls per job-scraper run (v2 Job Board, Source 3)
LLM_EXTRACT_MAX_PER_RUN=50

# ── Job APIs (v2: three-source pipeline) ─────────────────────────────────────
JSEARCH_API_KEY=your_jsearch_key_here
SERPAPI_KEY=your_serpapi_key_here
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
APIFY_TOKEN=your_apify_token

# ── TTS (AI Interviewer — third-party provider, proxied server-side) ─────────
# STT is browser Web Speech API — no key needed.
TTS_PROVIDER=your_tts_provider_name
TTS_API_KEY=your_tts_key_here

# ── Email (AWS SES) ──────────────────────────────────────────────────────────
SES_FROM_EMAIL=noreply@voxeralaw.in
